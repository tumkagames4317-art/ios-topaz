- * ifnet tw0 datapath (0133) + wifiip= (0134); 4-way when wifipsk= (0132).
+ * ifnet tw0 + wifiip=/dhcp (0133-0135); 4-way when wifipsk= (0132).
  */
 #ifndef _BSD_SYS_TOPAZ_WLAN_H_
 #define _BSD_SYS_TOPAZ_WLAN_H_
@@ -41,6 +41,7 @@ bool topaz_wlan_tx_ethernet(const uint8_t *eth, unsigned len);
 void topaz_wlan_if_init(void);
