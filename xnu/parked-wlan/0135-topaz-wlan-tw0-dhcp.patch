+static uint16_t
+tw_ip_cksum(const void *data, unsigned len)
+{
+	const uint16_t *w = (const uint16_t *)data;
+	uint32_t sum = 0;
+
+	while (len > 1) {
+		sum += ntohs(*w++);
+		len -= 2;
+	}
+	if (len != 0) {
+		sum += *(const uint8_t *)w << 8;
+	}
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return htons((uint16_t)~sum);
+}
