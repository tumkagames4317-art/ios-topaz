Subject: [PATCH] topaz-0132: in-kernel WPA2-PSK 4-way handshake

PBKDF2-HMAC-SHA1 PMK, PRF PTK, EAPOL MIC, AES key-unwrap GTK.
Boot-arg wifipsk= drives topaz_wlan_wpa.c; TopazModem sends msg2/msg4
via HTT and installs keys through topaz_wlan_install_key (0131).

diff --git a/bsd/sys/topaz_wlan_wpa.h b/bsd/sys/topaz_wlan_wpa.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/topaz_wlan_wpa.h
@@ -0,0 +1,43 @@
+/*
+ * topaz: WPA2-PSK 4-way handshake (0132). Used by TopazModem when wifipsk= is set.
+ */
+#ifndef _BSD_SYS_TOPAZ_WLAN_WPA_H_
+#define _BSD_SYS_TOPAZ_WLAN_WPA_H_
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct topaz_wlan_wpa_keys {
+	uint8_t tk[16];
+	uint8_t gtk[32];
+	unsigned gtk_len;
+	unsigned gtk_id;
+	bool have_gtk;
+	bool done;
+};
+
+/* Arm after assoc to a privacy BSS. rsn_ie is the full IE (id+len+body), or NULL. */
+void topaz_wlan_wpa_start(const uint8_t *ssid, unsigned ssid_len,
+    const char *psk, const uint8_t spa[6], const uint8_t aa[6],
+    const uint8_t *rsn_ie, unsigned rsn_ie_len);
+
+void topaz_wlan_wpa_reset(void);
+
+/*
+ * Feed an EAPOL frame (starts at 802.1X header). Writes reply EAPOL into out[].
+ * Returns reply length (>0), 0 if none, or -1 on hard error (logged).
+ * When keys->done, install TK/GTK via topaz_wlan_install_key and authorize.
+ */
+int topaz_wlan_wpa_on_eapol(const uint8_t *eapol, unsigned len,
+    uint8_t *out, unsigned out_max, struct topaz_wlan_wpa_keys *keys);
+
+bool topaz_wlan_wpa_active(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BSD_SYS_TOPAZ_WLAN_WPA_H_ */


