+
+static bool
+assoc_is_up(void)
+{
+	return a_up;
+}
+
+#define CMD_VDEV_INSTALL_KEY 0x5009
+#define TAG_VDEV_INSTALL_KEY 0x60
+#define KEY_FLAG_GROUP       0x1
+
+extern "C" int
+topaz_wlan_install_key(bool group, unsigned key_idx, unsigned cipher,
+    const uint8_t *key, unsigned key_len)
+{
+	uint8_t m[4 + 92 + 4 + 32], *p;
+	uint32_t kl;
+
+	if (!a_up || key == NULL || key_len == 0 || key_len > 32) {
+		return EINVAL;
+	}
+	kl = ASSOC_ALIGN4(key_len);
+	bzero(m, sizeof(m));
+	p = wmi_put_tlv(m, TAG_VDEV_INSTALL_KEY, 92);
+	p = put32(p, ASSOC_VDEV);
+	p = a_pmac(p, a_req.bssid);
+	p = put32(p, key_idx);
+	p = put32(p, group ? KEY_FLAG_GROUP : 0);
+	p = put32(p, cipher);
+	p += 3 * 8 + 16 + 16;
+	p = put32(p, key_len);
+	p = put32(p, cipher == 2 ? 8 : 0);
+	p = put32(p, cipher == 2 ? 8 : 0);
+	p = wmi_put_tlv(p, TAG_ARRAY_BYTE, kl);
+	memcpy(p, key, key_len);
+	if (!wmi_send(CMD_VDEV_INSTALL_KEY, m, 4 + 92 + 4 + kl)) {
+		return EIO;
+	}
+	LOG("t=%u ms: assoc: install %s key idx %u cipher %u len %u", g_ms,
+	    group ? "group" : "pairwise", key_idx, cipher, key_len);
+	if (!group) {
+		a_ptk = true;
+		a_peer_param(a_req.bssid, PEER_PARAM_AUTHORIZE, 1);
+		LOG("t=%u ms: assoc: PTK installed, peer authorized", g_ms);
+	}
+	return 0;
+}
+
+static void
+assoc_on_rx_msdu(const uint8_t *frame, uint32_t len)
+{
+	if (len >= 32 && frame[24] == 0xAA && frame[25] == 0xAA &&
+	    frame[30] == 0x88 && frame[31] == 0x8E) {
+		LOG("t=%u ms: assoc: EAPOL rx %u B (4-way TODO, wifipsk %s)",
+		    g_ms, len, a_boot_psk_set ? "set" : "unset");
+	}
+}
+
+/* HTT native-wifi TX (topaz-woa htt.c TxOne); EAPOL / data once associated. */
+#define HTT_TX_SLOTS     32
+#define HTT_TX_SLOT_SIZE 2048
+#define HTT_PREFETCH     50
+static uint8_t *htt_tx_pool;
+static uint64_t htt_tx_pool_pa;
+static uint32_t htt_tx_next, htt_tx_sent;
+
+extern "C" bool
+topaz_wlan_tx(const uint8_t *frame, unsigned len)
+{
+	uint8_t m[20 + 52], *p, *ext, f0;
+	uint32_t id, pf;
+	uint64_t pa;
+	bool eapol;
+
+	if (!a_up || frame == NULL || len < 24 || len > HTT_TX_SLOT_SIZE ||
+	    htt_state != 2 || htt_bank == NULL) {
+		return false;
+	}
+	if (htt_tx_pool == NULL) {
+		htt_tx_pool = (uint8_t *)pool_alloc(
+		    HTT_TX_SLOTS * HTT_TX_SLOT_SIZE, &htt_tx_pool_pa);
+		if (htt_tx_pool == NULL) {
+			return false;
+		}
+	}
+	id = htt_tx_next++ % HTT_TX_SLOTS;
+	pa = htt_tx_pool_pa + (uint64_t)id * HTT_TX_SLOT_SIZE;
+	memcpy(htt_tx_pool + (size_t)id * HTT_TX_SLOT_SIZE, frame, len);
+	ext = htt_bank + (size_t)id * HTT_EXT_DESC_SIZE;
+	bzero(ext, HTT_EXT_DESC_SIZE);
+	*(uint32_t *)(ext + 24) = (uint32_t)pa;
+	*(uint16_t *)(ext + 28) = (uint16_t)(pa >> 32);
+	*(uint16_t *)(ext + 30) = (uint16_t)len;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	eapol = len >= 32 && frame[24] == 0xAA && frame[25] == 0xAA &&
+	    frame[30] == 0x88 && frame[31] == 0x8E;
+	f0 = 0x01 | (1u << 5); /* MAC_HDR | NATIVE */
+	if (eapol && !a_ptk) {
+		f0 |= 0x04; /* NO_ENCRYPT */
+	}
+	pf = HTT_TX_ALIGN4(MIN(len, (unsigned)HTT_PREFETCH));
+	bzero(m, sizeof(m));
+	p = m;
+	*p++ = H2T_TX_FRM;
+	*p++ = f0;
+	p = put16(p, (uint16_t)((16u << 6) | (1u << 11))); /* NON_QOS | POSTPONED */
+	p = put16(p, (uint16_t)len);
+	p = put16(p, (uint16_t)id);
+	p = put64(p, htt_bank_pa + (uint64_t)id * HTT_EXT_DESC_SIZE);
+	*(uint32_t *)p = 0xFFFF;
+	p += 4;
+	memcpy(p, frame, MIN(len, pf));
+	if (!htt_send(m, 20 + pf)) {
+		return false;
+	}
+	htt_tx_sent++;
+	if (htt_tx_sent <= 8) {
+		LOG("t=%u ms: htt tx id %u len %u%s", g_ms, id, len,
+		    eapol ? " EAPOL" : "");
+	}
+	return true;
+}
