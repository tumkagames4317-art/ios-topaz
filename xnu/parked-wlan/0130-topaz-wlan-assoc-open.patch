+extern "C" int
+topaz_wlan_connect_bss(unsigned index)
+{
+	if (index >= nbss) {
+		return ENOENT;
+	}
+	if (bss[index].capab & 0x0010) {
+		return EPERM; /* open networks only in 0130 */
+	}
+	assoc_fill_from_bss(&bss[index]);
+	return 0;
