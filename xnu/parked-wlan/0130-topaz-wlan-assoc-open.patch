+static void
+assoc_poll(void)
+{
+	bool start = false;
+	static bool parsed;
+
+	if (!parsed) {
+		parsed = true;
+		a_boot_ssid_set = PE_parse_boot_argn("wifissid",
+		    a_boot_ssid, sizeof(a_boot_ssid));
+		if (a_boot_ssid_set && a_boot_ssid[0] != '\0') {
+			LOG("t=%u ms: assoc: will join open SSID '%s'",
+			    g_ms, a_boot_ssid);
+		} else {
+			a_boot_ssid_set = false;
+		}
+	}
+	if (scans != a_last_scans) {
+		a_last_scans = scans;
+		assoc_try_auto();
+	}
+	if (a_disc) {
+		a_disc = false;
+		a_req_new = false;
