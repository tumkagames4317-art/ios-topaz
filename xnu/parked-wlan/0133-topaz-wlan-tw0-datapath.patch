Subject: [PATCH] topaz-0133: HTT MSDU ↔ tw0 ethernet datapath

Bridge authorized station traffic: HTT RX MSDUs (non-EAPOL) become
ethernet frames into tw0; tw0 output encapsulates ToDS 802.11 + LLC and
sends via topaz_wlan_tx. EAPOL path from 0132 unchanged (QoS hdr aware).
diff --git a/bsd/sys/topaz_wlan.h b/bsd/sys/topaz_wlan.h
--- a/bsd/sys/topaz_wlan.h
+++ b/bsd/sys/topaz_wlan.h
@@ -2,7 +2,7 @@
  * topaz: WCN3988 radio C API (implemented in iokit/Kernel/arm/TopazModem.cpp
  * when boot-arg wifi=1). Scan + BSS list with beacon IEs; open-network
  * association (0130); WPA2-PSK assoc + key install (0131); ready hook for
- * ifnet / future IO80211. 4-way in topaz_wlan_wpa.c when wifipsk= (0132).
+ * ifnet tw0 datapath (0133); 4-way in topaz_wlan_wpa.c when wifipsk= (0132).
  */
 #ifndef _BSD_SYS_TOPAZ_WLAN_H_
 #define _BSD_SYS_TOPAZ_WLAN_H_
@@ -36,9 +36,11 @@ bool topaz_wlan_authorized(void);                   /* PTK installed (or open) *
 int topaz_wlan_install_key(bool group, unsigned key_idx, unsigned cipher,
     const uint8_t *key, unsigned key_len);          /* cipher 4 = CCMP */
 bool topaz_wlan_tx(const uint8_t *frame, unsigned len); /* native 802.11 via HTT */
+bool topaz_wlan_tx_ethernet(const uint8_t *eth, unsigned len); /* eth → ToDS via HTT */
 
 /* bsd/dev/topaz_wlan_if.c — register hook early (before topaz_modem_init). */
 void topaz_wlan_if_init(void);
+void topaz_wlan_if_input(const uint8_t *eth, unsigned len); /* HTT RX → tw0 */
 
 #ifdef __cplusplus
 }

diff --git a/bsd/dev/topaz_wlan_if.c b/bsd/dev/topaz_wlan_if.c
--- a/bsd/dev/topaz_wlan_if.c
+++ b/bsd/dev/topaz_wlan_if.c
@@ -1,6 +1,7 @@
 /*
- * topaz: attach ifnet tw0 when TopazModem WLAN radio is ready (0126 API).
- * Stub only â€” no assoc / datapath. Output frees mbufs. sweetwlanif=0 skips.
+ * topaz: ifnet tw0 when TopazModem WLAN radio is ready.
+ * 0133: ethernet TX via topaz_wlan_tx_ethernet; RX via topaz_wlan_if_input.
+ * sweetwlanif=0 skips. Needs assoc (+ PTK for WPA2) for datapath.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -27,11 +28,29 @@ static bool tw_attached;
 static errno_t
 tw_output(ifnet_t ifp, mbuf_t m)
 {
-	(void)ifp;
-	if (m != NULL) {
+	uint8_t buf[1518];
+	size_t len;
+
+	if (m == NULL) {
+		return 0;
+	}
+	len = mbuf_pkthdr_len(m);
+	if (len < ETHER_HDR_LEN || len > sizeof(buf)) {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		mbuf_freem(m);
+		return 0;
+	}
+	if (mbuf_copydata(m, 0, len, buf) != 0) {
 		ifnet_stat_increment_out(ifp, 0, 0, 1);
 		mbuf_freem(m);
+		return 0;
+	}
+	mbuf_freem(m);
+	if (!topaz_wlan_authorized() || !topaz_wlan_tx_ethernet(buf, (unsigned)len)) {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
 	}
+	ifnet_stat_increment_out(ifp, 1, (int)len, 0);
 	return 0;
 }
 
@@ -114,7 +133,7 @@ tw_attach_ifnet(void)
 	ifnet_set_lladdr(tw_ifp, mac, ETHER_ADDR_LEN);
 	ifnet_set_flags(tw_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
 	tw_attached = true;
-	printf("SWEET WLAN: tw0 up %02x:%02x:%02x:%02x:%02x:%02x (no assoc yet)\n",
+	printf("SWEET WLAN: tw0 up %02x:%02x:%02x:%02x:%02x:%02x (HTT datapath)\n",
 	    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
 }
 
@@ -128,6 +147,37 @@ tw_on_ready(void)
 	tw_attach_ifnet();
 }
 
+void
+topaz_wlan_if_input(const uint8_t *eth, unsigned len)
+{
+	mbuf_t m = NULL;
+	struct ifnet_stat_increment_param stats;
+
+	if (!tw_attached || tw_ifp == NULL || eth == NULL ||
+	    len < ETHER_HDR_LEN || len > ETHER_MAX_LEN) {
+		return;
+	}
+	if (mbuf_allocpacket(MBUF_DONTWAIT, len, NULL, &m) != 0 || m == NULL) {
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, eth, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(m);
+		return;
+	}
+	bzero(&stats, sizeof(stats));
+	{
+		void *frame_header = mbuf_data(m);
+
+		mbuf_pkthdr_setrcvif(m, tw_ifp);
+		mbuf_pkthdr_setheader(m, frame_header);
+		mbuf_pkthdr_adjustlen(m, -(int)ETHER_HDR_LEN);
+		(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN,
+		    mbuf_len(m) - ETHER_HDR_LEN);
+	}
+	stats.packets_in = 1;
+	stats.bytes_in = len;
+	ifnet_input(tw_ifp, m, &stats);
+}
 void
 topaz_wlan_if_init(void)
 {
@@ -152,4 +204,10 @@ void
 topaz_wlan_if_init(void)
 {
 }
+void
+topaz_wlan_if_input(const uint8_t *eth, unsigned len)
+{
+	(void)eth;
+	(void)len;
+}
 #endif

diff --git a/iokit/Kernel/arm/TopazModem.cpp b/iokit/Kernel/arm/TopazModem.cpp
--- a/iokit/Kernel/arm/TopazModem.cpp
+++ b/iokit/Kernel/arm/TopazModem.cpp
@@ -4588,6 +4588,7 @@
 
 /* ---------------- open-network station association (topaz-woa assoc.c) */
 #include <sys/topaz_wlan_wpa.h>
+extern "C" void topaz_wlan_if_input(const uint8_t *eth, unsigned len);
 
 #define CMD_VDEV_START      0x5003
 #define CMD_VDEV_UP         0x5005
@@ -5165,48 +5166,102 @@ topaz_wlan_install_key(bool group, unsigned key_idx, unsigned cipher,
 static void
 assoc_on_rx_msdu(const uint8_t *frame, uint32_t len)
 {
-	if (len < 32 || frame[24] != 0xAA || frame[25] != 0xAA ||
-	    frame[30] != 0x88 || frame[31] != 0x8E) {
-		return;
-	}
-	LOG("t=%u ms: assoc: EAPOL rx %u B", g_ms, len);
-	if (!topaz_wlan_wpa_active()) {
-		return;
-	}
-	{
-		uint8_t reply[512], tx[24 + 8 + 512];
-		struct topaz_wlan_wpa_keys keys;
-		int rl;
-
-		bzero(&keys, sizeof(keys));
-		rl = topaz_wlan_wpa_on_eapol(frame + 32, len - 32, reply,
-		    sizeof(reply), &keys);
-		if (rl > 0) {
-			bzero(tx, 24);
-			tx[0] = 0x08;
-			tx[1] = 0x01; /* ToDS data */
-			memcpy(tx + 4, a_req.bssid, 6);
-			memcpy(tx + 10, our_mac, 6);
-			memcpy(tx + 16, a_req.bssid, 6);
-			tx[24] = 0xAA; tx[25] = 0xAA; tx[26] = 0x03;
-			tx[27] = 0; tx[28] = 0; tx[29] = 0;
-			tx[30] = 0x88; tx[31] = 0x8E;
-			memcpy(tx + 32, reply, (unsigned)rl);
-			if (!topaz_wlan_tx(tx, 32 + (unsigned)rl)) {
-				LOG("t=%u ms: assoc: EAPOL tx failed", g_ms);
-			}
-		}
-		if (keys.done) {
-			if (topaz_wlan_install_key(false, 0, 4, keys.tk, 16) != 0) {
-				LOG("t=%u ms: assoc: PTK install failed", g_ms);
-			}
-			if (keys.have_gtk &&
-			    topaz_wlan_install_key(true, keys.gtk_id, 4,
-			    keys.gtk, keys.gtk_len) != 0) {
-				LOG("t=%u ms: assoc: GTK install failed", g_ms);
-			}
-		}
-	}
+	unsigned hdr, llc, ethertype, pay;
+	uint8_t type, subtype, ds;
+	static uint32_t data_rx;
+
+	if (frame == NULL || len < 24) {
+		return;
+	}
+	type = frame[0] & 0x0C;
+	subtype = (uint8_t)(frame[0] >> 4);
+	if (type != 0x08) {
+		return; /* data only */
+	}
+	ds = frame[1] & 0x03;
+	hdr = 24;
+	if ((subtype & 0x08) != 0) {
+		hdr += 2; /* QoS Control */
+	}
+	if (ds == 0x03) {
+		hdr += 6; /* Addr4 */
+	}
+	if (len < hdr + 8) {
+		return;
+	}
+	llc = hdr;
+	if (frame[llc] != 0xAA || frame[llc + 1] != 0xAA || frame[llc + 2] != 0x03) {
+		return;
+	}
+	ethertype = ((unsigned)frame[llc + 6] << 8) | frame[llc + 7];
+	pay = llc + 8;
+
+	if (ethertype == 0x888E) {
+		LOG("t=%u ms: assoc: EAPOL rx %u B", g_ms, len);
+		if (!topaz_wlan_wpa_active()) {
+			return;
+		}
+		{
+			uint8_t reply[512], tx[24 + 8 + 512];
+			struct topaz_wlan_wpa_keys keys;
+			int rl;
+
+			bzero(&keys, sizeof(keys));
+			rl = topaz_wlan_wpa_on_eapol(frame + pay, len - pay, reply,
+			    sizeof(reply), &keys);
+			if (rl > 0) {
+				bzero(tx, 24);
+				tx[0] = 0x08;
+				tx[1] = 0x01;
+				memcpy(tx + 4, a_req.bssid, 6);
+				memcpy(tx + 10, our_mac, 6);
+				memcpy(tx + 16, a_req.bssid, 6);
+				tx[24] = 0xAA; tx[25] = 0xAA; tx[26] = 0x03;
+				tx[27] = 0; tx[28] = 0; tx[29] = 0;
+				tx[30] = 0x88; tx[31] = 0x8E;
+				memcpy(tx + 32, reply, (unsigned)rl);
+				if (!topaz_wlan_tx(tx, 32 + (unsigned)rl)) {
+					LOG("t=%u ms: assoc: EAPOL tx failed", g_ms);
+				}
+			}
+			if (keys.done) {
+				if (topaz_wlan_install_key(false, 0, 4, keys.tk, 16) != 0) {
+					LOG("t=%u ms: assoc: PTK install failed", g_ms);
+				}
+				if (keys.have_gtk &&
+				    topaz_wlan_install_key(true, keys.gtk_id, 4,
+				    keys.gtk, keys.gtk_len) != 0) {
+					LOG("t=%u ms: assoc: GTK install failed", g_ms);
+				}
+			}
+		}
+		return;
+	}
+
+	/* IP / other ethertypes → tw0 once authorized (open or PTK). */
+	if (!a_up || !a_ptk || len < pay) {
+		return;
+	}
+	{
+		uint8_t eth[1518];
+		unsigned elen = 14 + (len - pay);
+
+		if (elen < 14 || elen > sizeof(eth)) {
+			return;
+		}
+		/* FromDS: Addr1=DA, Addr3=SA */
+		memcpy(eth + 0, frame + 4, 6);
+		memcpy(eth + 6, frame + 16, 6);
+		eth[12] = (uint8_t)(ethertype >> 8);
+		eth[13] = (uint8_t)ethertype;
+		memcpy(eth + 14, frame + pay, len - pay);
+		topaz_wlan_if_input(eth, elen);
+		data_rx++;
+		if (data_rx <= 8 || (data_rx % 256) == 0) {
+			LOG("t=%u ms: assoc: data rx #%u ethertype 0x%04x %u B",
+			    g_ms, data_rx, ethertype, elen);
+		}
+	}
 }
 
 /* HTT native-wifi TX (topaz-woa htt.c TxOne); EAPOL / data once associated. */
@@ -5280,6 +5346,43 @@ topaz_wlan_tx(const uint8_t *frame, unsigned len)
 	return true;
 }
 
+extern "C" bool
+topaz_wlan_tx_ethernet(const uint8_t *eth, unsigned len)
+{
+	uint8_t frame[24 + 8 + 1500];
+	unsigned plen;
+	static uint32_t data_tx;
+
+	if (!a_up || !a_ptk || eth == NULL || len < 14 || len > 14 + 1500) {
+		return false;
+	}
+	plen = len - 14;
+	bzero(frame, 24);
+	frame[0] = 0x08;
+	frame[1] = 0x01; /* ToDS */
+	memcpy(frame + 4, a_req.bssid, 6);
+	memcpy(frame + 10, eth + 6, 6); /* SA */
+	memcpy(frame + 16, eth + 0, 6); /* DA */
+	frame[24] = 0xAA;
+	frame[25] = 0xAA;
+	frame[26] = 0x03;
+	frame[27] = 0;
+	frame[28] = 0;
+	frame[29] = 0;
+	frame[30] = eth[12];
+	frame[31] = eth[13];
+	memcpy(frame + 32, eth + 14, plen);
+	if (!topaz_wlan_tx(frame, 32 + plen)) {
+		return false;
+	}
+	data_tx++;
+	if (data_tx <= 8 || (data_tx % 256) == 0) {
+		LOG("t=%u ms: assoc: data tx #%u ethertype 0x%02x%02x %u B",
+		    g_ms, data_tx, eth[12], eth[13], len);
+	}
+	return true;
+}
+
 extern "C" int
 topaz_wlan_connect_bss(unsigned index)
 {
