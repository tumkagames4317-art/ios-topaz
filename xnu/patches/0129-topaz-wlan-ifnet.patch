diff --git a/bsd/sys/topaz_wlan.h b/bsd/sys/topaz_wlan.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/topaz_wlan.h
@@ -0,0 +1,41 @@
+/*
+ * topaz: WCN3988 radio C API (implemented in iokit/Kernel/arm/TopazModem.cpp
+ * when boot-arg wifi=1). Scan + BSS list with beacon IEs; ready hook for
+ * ifnet / future IO80211. No association yet.
+ */
+#ifndef _BSD_SYS_TOPAZ_WLAN_H_
+#define _BSD_SYS_TOPAZ_WLAN_H_
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct topaz_wlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;                         /* MHz */
+	int16_t rssi;                               /* dBm */
+	uint16_t beacon_interval, capability;
+	uint32_t age_ms;
+	uint16_t elements_length;
+	uint8_t elements[768];
+};
+
+/* Set by a consumer before the radio comes up; called once from the modem thread. */
+extern void (*topaz_wlan_ready_hook)(void);
+
+bool topaz_wlan_ready(void);
+int topaz_wlan_scan(void);                          /* 0 ok, ENXIO/ETIMEDOUT */
+bool topaz_wlan_heard(unsigned index, struct topaz_wlan_bss *bss);
+void topaz_wlan_address(uint8_t address[6]);
+
+/* bsd/dev/topaz_wlan_if.c — register hook early (before topaz_modem_init). */
+void topaz_wlan_if_init(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _BSD_SYS_TOPAZ_WLAN_H_ */
diff --git a/bsd/dev/topaz_wlan_if.c b/bsd/dev/topaz_wlan_if.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/topaz_wlan_if.c
@@ -0,0 +1,155 @@
+/*
+ * topaz: attach ifnet tw0 when TopazModem WLAN radio is ready (0126 API).
+ * Stub only — no assoc / datapath. Output frees mbufs. sweetwlanif=0 skips.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/topaz_wlan.h>
+#include <net/ethernet.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+
+static ifnet_t tw_ifp;
+static lck_mtx_t *tw_lock;
+static int tw_enabled = 1;
+static bool tw_hooked;
+static bool tw_attached;
+
+static errno_t
+tw_output(ifnet_t ifp, mbuf_t m)
+{
+	(void)ifp;
+	if (m != NULL) {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		mbuf_freem(m);
+	}
+	return 0;
+}
+
+static errno_t
+tw_ioctl(ifnet_t ifp, unsigned long cmd, void *data __unused)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCSIFFLAGS:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+tw_detach(ifnet_t ifp __unused)
+{
+}
+
+static void
+tw_attach_ifnet(void)
+{
+	struct ifnet_init_eparams init;
+	uint8_t mac[6];
+	static lck_grp_t *grp;
+
+	if (tw_attached || tw_ifp != NULL) {
+		return;
+	}
+	if (!topaz_wlan_ready()) {
+		return;
+	}
+	topaz_wlan_address(mac);
+
+	if (grp == NULL) {
+		grp = lck_grp_alloc_init("topaz_wlan", LCK_GRP_ATTR_NULL);
+	}
+	if (tw_lock == NULL) {
+		tw_lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+	}
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "topaz-wlan";
+	init.uniqueid_len = sizeof("topaz-wlan") - 1;
+	init.name = "tw";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = tw_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = tw_ioctl;
+	init.detach = tw_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+
+	if (ifnet_allocate_extended(&init, &tw_ifp) != 0) {
+		printf("SWEET WLAN: tw0 ifnet_allocate failed\n");
+		tw_ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(tw_ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(tw_ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(tw_ifp, ETHERMTU);
+	ifnet_set_baudrate(tw_ifp, 433000000); /* 802.11n-ish placeholder */
+	ifnet_set_flags(tw_ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(tw_ifp, NULL) != 0) {
+		printf("SWEET WLAN: tw0 ifnet_attach failed\n");
+		tw_ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(tw_ifp, mac, ETHER_ADDR_LEN);
+	ifnet_set_flags(tw_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	tw_attached = true;
+	printf("SWEET WLAN: tw0 up %02x:%02x:%02x:%02x:%02x:%02x (no assoc yet)\n",
+	    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+}
+
+static void
+tw_on_ready(void)
+{
+	/*
+	 * Called from the modem/WLAN poll thread. Do not call topaz_wlan_scan()
+	 * here (it sleeps waiting for that same thread). Attach only.
+	 */
+	tw_attach_ifnet();
+}
+
+void
+topaz_wlan_if_init(void)
+{
+	(void)PE_parse_boot_argn("sweetwlanif", &tw_enabled, sizeof(tw_enabled));
+	if (!tw_enabled) {
+		printf("SWEET WLAN: ifnet disabled (sweetwlanif=0)\n");
+		return;
+	}
+	if (tw_hooked) {
+		return;
+	}
+	tw_hooked = true;
+	topaz_wlan_ready_hook = tw_on_ready;
+	/* Radio may already be up if init races past first scan_started. */
+	if (topaz_wlan_ready()) {
+		tw_attach_ifnet();
+	}
+	printf("SWEET WLAN: ifnet hook armed (need wifi=1)\n");
+}
+#else /* !ARM64_BOARD_CONFIG_SWEET */
+void
+topaz_wlan_if_init(void)
+{
+}
+#endif
