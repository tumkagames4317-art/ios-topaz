--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -109,7 +109,8 @@ bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_touch.c			standard
 bsd/dev/sweet_i2c1.c			standard
 bsd/dev/sweet_rtc.c			standard
+bsd/dev/topaz_wlan_if.c			standard
 bsd/dev/sweet_cpufreq.c			standard
