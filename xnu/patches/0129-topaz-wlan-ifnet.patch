-}
+/* ---------------- the radio for the rest of the kernel (<sys/topaz_wlan.h>) */
+#include <sys/topaz_wlan.h>
+
+void (*topaz_wlan_ready_hook)(void);
 
 static volatile bool api_scan_asked;
 static bool api_ready;
 
 bool
 topaz_wlan_ready(void)
