Subject: [PATCH] topaz-0145: TopazWlan as IOEthernetController

Subclass IOEthernetController, attachInterface() an IOEthernetInterface,
and bridge HTT ethernet through outputPacket / a RX sink on
topaz_wlan_if_input. Link follows topaz_wlan_authorized().
tw0 remains unless sweetwlanif=0 (then only the IONetwork ifnet).
Needs 0144 IONetworkingFamily. Not IO80211.
diff --git a/bsd/sys/topaz_wlan.h b/bsd/sys/topaz_wlan.h
--- a/bsd/sys/topaz_wlan.h
+++ b/bsd/sys/topaz_wlan.h
@@ -47,6 +47,10 @@ void topaz_wlan_if_poll(uint32_t ms); /* DHCP retransmit */
 /* Host-order; false if tw0 has no IPv4 yet. dns may be 0. */
 bool topaz_wlan_if_ipv4(uint32_t *ip, uint32_t *mask, uint32_t *gw,
     uint32_t *dns);
+/* 0145: extra RX sink for IOEthernetInterface (tw0 still receives too). */
+typedef void (*topaz_wlan_enet_rx_fn)(const uint8_t *eth, unsigned len,
+    void *arg);
+void topaz_wlan_enet_set_rx(topaz_wlan_enet_rx_fn fn, void *arg);
 
 #ifdef __cplusplus
 }
diff --git a/bsd/dev/topaz_wlan_if.c b/bsd/dev/topaz_wlan_if.c
--- a/bsd/dev/topaz_wlan_if.c
+++ b/bsd/dev/topaz_wlan_if.c
@@ -3,6 +3,7 @@
  * 0133-0137: HTT + wifiip=/dhcp + renew + GARP. 0141: clear IP on disconnect.
  * 0142: topaz_wlan_if_ipv4() for sysctl/ioreg (stores DHCP DNS).
  * 0143: wifidns= stores resolver for static wifiip= (DHCP still uses opt 6).
+ * 0145: optional IOEthernet RX sink (sweetwlanif=0 leaves only that ifnet).
  * sweetwlanif=0 skips. wifigarpon=0 disables GARP.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -70,6 +71,15 @@ static unsigned tw_dhcp_tries;
 #define DHCP_DEFAULT_LEASE_SEC 3600
 
 static void tw_dhcp_start(uint32_t ms);
+static topaz_wlan_enet_rx_fn tw_enet_rx;
+static void *tw_enet_rx_arg;
+
+void
+topaz_wlan_enet_set_rx(topaz_wlan_enet_rx_fn fn, void *arg)
+{
+	tw_enet_rx = fn;
+	tw_enet_rx_arg = arg;
+}
 
 static int
 tw_parse_ipv4(const char *s, uint32_t *host_order)
@@ -771,6 +781,10 @@ topaz_wlan_if_input(const uint8_t *eth, unsigned len)
 	mbuf_t m = NULL;
 	struct ifnet_stat_increment_param stats;
 
+	if (eth != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN &&
+	    tw_enet_rx != NULL) {
+		tw_enet_rx(eth, len, tw_enet_rx_arg);
+	}
 	if (!tw_attached || tw_ifp == NULL || eth == NULL ||
 	    len < ETHER_HDR_LEN || len > ETHER_MAX_LEN) {
 		return;
@@ -953,4 +967,10 @@ topaz_wlan_if_ipv4(uint32_t *ip, uint32_t *mask, uint32_t *gw, uint32_t *dns)
 	}
 	return false;
 }
+void
+topaz_wlan_enet_set_rx(topaz_wlan_enet_rx_fn fn, void *arg)
+{
+	(void)fn;
+	(void)arg;
+}
 #endif
diff --git a/iokit/Kernel/arm/TopazWlan.cpp b/iokit/Kernel/arm/TopazWlan.cpp
