 TopazWlan::publish(void)
@@ -48,7 +70,6 @@ TopazWlan::publish(void)
 	setProperty("TopazWlanReady", ready ? kOSBooleanTrue : kOSBooleanFalse);
 	setProperty("TopazWlanAssociated", assoc ? kOSBooleanTrue : kOSBooleanFalse);
