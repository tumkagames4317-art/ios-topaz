+void
+TopazWlan::updateLink(void)
+{
+	UInt32 status = 0;
+
+	if (topaz_wlan_authorized()) {
+		status = kIONetworkLinkValid | kIONetworkLinkActive;
+	}
+	setLinkStatus(status, (status != 0) ? fMedium : 0, 433000000ULL);
+}
+
 void
 TopazWlan::timerFired(OSObject *owner, IOTimerEventSource *sender)
 {
@@ -101,70 +132,184 @@ TopazWlan::timerFired(OSObject *owner, IOTimerEventSource *sender)
 		return;
 	}
 	self->publish();
+	self->updateLink();
 	if (sender != NULL) {
 		sender->setTimeoutMS(2000);
 	}
 }
 
+IOReturn
+TopazWlan::getHardwareAddress(IOEthernetAddress *addrP)
+{
+	if (addrP == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!topaz_wlan_ready()) {
+		bzero(addrP->bytes, kIOEthernetAddressSize);
+		return kIOReturnNotReady;
+	}
+	topaz_wlan_address(addrP->bytes);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+TopazWlan::setMulticastMode(bool active)
+{
+	(void)active;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+TopazWlan::setPromiscuousMode(bool active)
+{
+	(void)active;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+TopazWlan::enable(IONetworkInterface *interface)
+{
+	(void)interface;
+	fEnabled = true;
+	updateLink();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+TopazWlan::disable(IONetworkInterface *interface)
+{
+	(void)interface;
+	fEnabled = false;
+	setLinkStatus(0, 0);
+	return kIOReturnSuccess;
+}
+
+UInt32
+TopazWlan::outputPacket(mbuf_t m, void *param)
+{
+	uint8_t buf[1518];
+	size_t len;
+
+	(void)param;
+	if (m == NULL) {
+		return kIOReturnOutputDropped;
+	}
+	len = mbuf_pkthdr_len(m);
+	if (!fEnabled || !topaz_wlan_authorized() ||
+	    len < kIOEthernetAddressSize * 2 + 2 || len > sizeof(buf) ||
+	    mbuf_copydata(m, 0, len, buf) != 0 ||
+	    !topaz_wlan_tx_ethernet(buf, (unsigned)len)) {
+		freePacket(m);
+		return kIOReturnOutputDropped;
+	}
+	freePacket(m);
+	return kIOReturnOutputSuccess;
+}
+
+void
+TopazWlan::submitRx(const uint8_t *eth, unsigned len)
+{
+	mbuf_t m;
+
+	if (!fEnabled || fIface == NULL || eth == NULL || len < 14 || len > 1518) {
+		return;
+	}
+	m = allocatePacket((UInt32)len);
+	if (m == NULL) {
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, eth, MBUF_DONTWAIT) != 0) {
+		freePacket(m);
+		return;
+	}
+	fIface->inputPacket(m, (UInt32)len, 0, 0);
+}
+
